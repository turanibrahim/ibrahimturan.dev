---
import VBadge from '@/components/atoms/v-badge.astro';
import VIcon from '@/components/atoms/v-icon.astro';
import type { VTechBadgeProps } from '@/types/v-tech-badge';
type Props = VTechBadgeProps;

const { technology } = Astro.props;
---

<VBadge variant="dash" color="secondary">
  <VIcon name={technology.icon} />
  <span>{technology.name}</span>
</VBadge>
