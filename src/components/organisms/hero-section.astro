---
import VAvatar from '@/components/atoms/v-avatar.astro';
import VCard from '@/components/atoms/v-card.astro';
import VHeading from '@/components/atoms/v-heading.astro';
import VBlurText from '@/components/atoms/v-blur-text.vue';
import VPrismBackground from '@/components/atoms/v-prism-background.vue';
import SocialLinks from '@/components/molecules/social-links.astro';
import userInfoData from '@/data/userInfo.json';

const { userInfo } = userInfoData;
const fullName = `${userInfo.name} ${userInfo.surname}`;
---

<section id="home" aria-labelledby="hero-name" class="relative overflow-hidden bg-base-300">
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <VPrismBackground
      client:visible
      animationType="hover"
      timeScale={0.15}
      height={2.6}
      baseWidth={5.5}
      scale={3}
      hueShift={140}
      colorFrequency={0.6}
      noise={0}
      glow={0.4}
      bloom={0.6}
    />
  </div>

  <div class="container relative z-10 py-10 md:py-16 lg:py-20">
    <VCard class="bg-base-100/60 backdrop-blur-sm" bordered>
      <div
        class="flex flex-col items-center gap-6 text-center md:flex-row md:items-center md:gap-8 md:py-6 md:text-left lg:gap-12"
      >
        <div class="shrink-0">
          <VAvatar
            src={userInfo.profileImg}
            alt={fullName}
            size="xl"
            shape="rounded"
            ring
            priority
          />
        </div>

        <div class="min-w-0 flex-1 space-y-3">
          <VHeading
            id="hero-name"
            level="1"
            weight="black"
            class="text-balance text-4xl leading-[1.05] tracking-[-0.04em] text-base-content sm:text-5xl md:text-6xl lg:text-7xl"
          >
            <VBlurText client:only="vue" text={fullName} animateBy="words" direction="top">
              <span slot="fallback">{fullName}</span>
            </VBlurText>
          </VHeading>

          <VHeading
            level="3"
            weight="semibold"
            class="text-lg tracking-[-0.02em] text-secondary sm:text-xl"
          >
            {userInfo.title}
          </VHeading>

          <p class="max-w-prose text-base leading-relaxed text-base-content-muted sm:text-lg">
            {userInfo.tagline}
          </p>

          <div class="pt-2">
            <SocialLinks />
          </div>
        </div>
      </div>
    </VCard>
  </div>
</section>
