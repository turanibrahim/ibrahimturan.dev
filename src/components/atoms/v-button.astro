---
import type { ButtonColor, ButtonSize, ButtonVariant, VButtonProps } from '@/types/v-button';

interface Props extends VButtonProps {
  class?: string;
  target?: string;
  rel?: string;
  ariaLabel?: string;
  type?: 'button' | 'submit' | 'reset';
}

const {
  color,
  variant,
  size = 'md',
  wide = false,
  block = false,
  square = false,
  circle = false,
  active = false,
  disabled = false,
  loading = false,
  tag = 'button',
  href,
  class: className,
  target,
  rel,
  ariaLabel,
  type = 'button',
} = Astro.props;

const colorClasses: Record<ButtonColor, string> = {
  neutral: 'btn-neutral',
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  accent: 'btn-accent',
  info: 'btn-info',
  success: 'btn-success',
  warning: 'btn-warning',
  error: 'btn-error',
};

const variantClasses: Record<ButtonVariant, string> = {
  outline: 'btn-outline',
  dash: 'btn-dash',
  soft: 'btn-soft',
  ghost: 'btn-ghost',
  link: 'btn-link',
};

const sizeClasses: Record<ButtonSize, string> = {
  xs: 'btn-xs',
  sm: 'btn-sm',
  md: '',
  lg: 'btn-lg',
  xl: 'btn-xl',
};

const Tag = href || tag === 'a' ? 'a' : 'button';
const classes = [
  'btn',
  color && colorClasses[color],
  variant && variantClasses[variant],
  sizeClasses[size],
  wide && 'btn-wide',
  block && 'btn-block',
  square && 'btn-square',
  circle && 'btn-circle',
  active && 'btn-active',
  (disabled || loading) && 'btn-disabled',
  className,
];
---

{
  Tag === 'a' ? (
    <a
      href={href}
      class:list={classes}
      target={target}
      rel={rel}
      aria-label={ariaLabel}
      aria-disabled={disabled || loading ? 'true' : undefined}
    >
      {loading ? <span class="loading loading-spinner" /> : <slot />}
    </a>
  ) : (
    <button type={type} class:list={classes} aria-label={ariaLabel} disabled={disabled || loading}>
      {loading ? <span class="loading loading-spinner" /> : <slot />}
    </button>
  )
}

<style>
  .btn-disabled {
    cursor: not-allowed;
  }
</style>
