---
import { FaDev, FaGithub, FaLinkedin, FaTwitter } from 'oh-vue-icons/icons/fa';
import {
  SiAmazonaws,
  SiDocker,
  SiExpress,
  SiGithubactions,
  SiJavascript,
  SiNextdotjs,
  SiNodedotjs,
  SiNuxtdotjs,
  SiPostgresql,
  SiReact,
  SiRedis,
  SiTailwindcss,
  SiTypescript,
  SiVite,
  SiVuedotjs,
} from 'oh-vue-icons/icons/si';
import type { VIconProps } from '@/types/v-icon';

interface Props extends VIconProps {
  class?: string;
}

const icons: Record<string, typeof FaGithub> = {
  'fa-dev': FaDev,
  'fa-github': FaGithub,
  'fa-linkedin': FaLinkedin,
  'fa-twitter': FaTwitter,
  'si-amazonaws': SiAmazonaws,
  'si-docker': SiDocker,
  'si-express': SiExpress,
  'si-githubactions': SiGithubactions,
  'si-javascript': SiJavascript,
  'si-nextdotjs': SiNextdotjs,
  'si-nodedotjs': SiNodedotjs,
  'si-nuxtdotjs': SiNuxtdotjs,
  'si-postgresql': SiPostgresql,
  'si-react': SiReact,
  'si-redis': SiRedis,
  'si-tailwindcss': SiTailwindcss,
  'si-typescript': SiTypescript,
  'si-vite': SiVite,
  'si-vuedotjs': SiVuedotjs,
};

const { name, scale = 1, animation, flip, label, class: className } = Astro.props;
const icon = icons[name];

if (!icon) {
  throw new Error(`Unknown icon: ${name}`);
}

const flipTransforms = {
  horizontal: 'scaleX(-1)',
  vertical: 'scaleY(-1)',
  both: 'scale(-1)',
};

const transform = flip ? flipTransforms[flip] : undefined;
const dimension = `${scale}em`;
---

<svg
  viewBox={`${icon.minX} ${icon.minY} ${icon.width} ${icon.height}`}
  width={dimension}
  height={dimension}
  class:list={['v-icon', animation && `v-icon-${animation}`, className]}
  style={transform ? `transform: ${transform}` : undefined}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icon.raw}
/>

<style>
  .v-icon {
    display: inline-block;
    overflow: visible;
    vertical-align: -0.125em;
    fill: currentColor;
  }

  .v-icon-spin,
  .v-icon-pulse {
    animation: v-icon-spin 1s linear infinite;
  }

  .v-icon-pulse {
    animation-timing-function: steps(8);
  }

  @keyframes v-icon-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
