---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['navbar', className]}>
  <div class="navbar-start">
    <slot name="start" />
  </div>
  <div class="navbar-center">
    <slot name="center" />
  </div>
  <div class="navbar-end">
    <slot name="end" />
  </div>
</div>
