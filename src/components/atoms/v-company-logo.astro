---
import type { VCompanyLogoProps } from '@/types/v-company-logo';

interface Props extends VCompanyLogoProps {
  class?: string;
}

const { src, alt, size = 'md', rounded = 'lg', background = true, class: className } = Astro.props;

const sizeClasses: Record<string, string> = {
  sm: 'w-12 h-12',
  md: 'w-16 h-16',
  lg: 'w-20 h-20',
};

const roundedClasses: Record<string, string> = {
  sm: 'rounded',
  md: 'rounded-md',
  lg: 'rounded-lg',
  full: 'rounded-full',
};
---

<img
  src={src}
  alt={alt}
  class:list={[
    sizeClasses[size],
    roundedClasses[rounded],
    'object-contain',
    background && 'bg-base-200 p-2',
    className,
  ]}
  loading="lazy"
  decoding="async"
/>
