---
import { posts } from '@/data/content';
import DefaultLayout from '@/layouts/default.layout.astro';
import { formatDate } from '@/utils/date';
import { renderMarkdown } from '@/utils/markdown';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const bodyHtml = await renderMarkdown(post.bodyMarkdown);
const pageTitle = `${post.title} — İbrahim Turan`;
---

<DefaultLayout
  path={`/blog/${post.slug}`}
  title={pageTitle}
  description={post.excerpt}
  language={post.language}
  image={post.imageUrl}
  openGraphType="article"
  publishedAt={post.publishedAt}
  tags={post.tags}
>
  <div class="container pb-20 pt-8 sm:pb-24 sm:pt-10 lg:pb-32">
    <header class="flex items-center justify-between py-4 lg:py-6">
      <a href="/" class="font-mono text-sm font-semibold tracking-tight text-base-content">
        it<span class="text-primary">.</span>
      </a>
      <nav
        aria-label="Primary navigation"
        class="flex items-center gap-5 font-mono text-xs text-base-content-muted sm:gap-8"
      >
        <a href="/" class="transition-colors hover:text-primary">home</a>
        <a href="/blog" class="text-primary">blog</a>
      </nav>
    </header>

    <article class="mt-12 sm:mt-16 lg:mt-20">
      <header class="border-b border-base-300 pb-10 sm:pb-12 lg:pb-16">
        <div
          class="flex flex-col gap-3 font-mono text-xs text-base-content-muted sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
            <span aria-hidden="true">/</span>
            <span>{post.readingTimeMinutes} min read</span>
            <span aria-hidden="true">/</span>
            <span lang={post.language}>{post.language.toUpperCase()}</span>
          </div>
          <div class="flex flex-wrap gap-x-3 gap-y-1">
            {post.tags.map((tag) => <span class="text-secondary">#{tag}</span>)}
          </div>
        </div>

        <div
          class:list={[
            'mt-8 grid items-center gap-10 sm:mt-10 lg:gap-12 xl:gap-16',
            post.imageUrl ? 'lg:grid-cols-12' : '',
          ]}
        >
          <div class:list={[post.imageUrl ? 'lg:col-span-7' : 'max-w-5xl']}>
            <h1 class="article-title text-balance font-extrabold text-base-content">
              {post.title}
            </h1>
            <p
              class="mt-6 max-w-3xl text-pretty text-lg leading-relaxed text-base-content-muted sm:text-xl"
            >
              {post.excerpt}
            </p>
          </div>

          {
            post.imageUrl && (
              <figure class="post-cover lg:col-span-5">
                <img
                  src={post.imageUrl}
                  alt=""
                  width="1200"
                  height="630"
                  class="aspect-[1200/630] w-full rounded-sm object-cover"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              </figure>
            )
          }
        </div>
      </header>

      <div class="blog-article mx-auto mt-12 max-w-[46rem] sm:mt-14 lg:mt-16">
        <Fragment set:html={bodyHtml} />
      </div>

      <footer
        class="mx-auto mt-16 flex max-w-[46rem] flex-wrap items-center justify-between gap-4 border-t border-base-300 pt-8 lg:mt-24"
      >
        <a
          href="/blog"
          class="font-mono text-xs text-base-content-muted transition-colors hover:text-primary"
        >
          &larr; All writing
        </a>
        {
          post.sourceUrl && (
            <a
              href={post.sourceUrl}
              target="_blank"
              rel="noreferrer noopener"
              class="font-mono text-xs text-base-content-muted transition-colors hover:text-primary"
            >
              Read on dev.to <span class="sr-only">(opens in a new tab)</span>
            </a>
          )
        }
      </footer>
    </article>
  </div>
</DefaultLayout>

<style is:global>
  .article-title {
    max-width: 14ch;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .post-cover {
    overflow: hidden;
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-md);
    background: var(--color-base-200);
    padding: 0.5rem;
  }

  .blog-article {
    width: 100%;
    color: var(--color-base-content-muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .blog-article p,
  .blog-article li {
    max-width: none;
  }

  .blog-article > :first-child {
    margin-top: 0;
  }

  .blog-article > p:first-child {
    color: var(--color-base-content);
    line-height: 1.8;
  }

  .blog-article p {
    margin: 0 0 1.625rem;
  }

  .blog-article h2 {
    margin: 4rem 0 1.125rem;
    scroll-margin-top: 2rem;
    color: var(--color-base-content);
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .blog-article h3 {
    margin: 3rem 0 1rem;
    scroll-margin-top: 2rem;
    color: var(--color-base-content);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .blog-article h4 {
    margin: 2.5rem 0 0.875rem;
    scroll-margin-top: 2rem;
    color: var(--color-base-content);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .blog-article strong {
    color: var(--color-base-content);
    font-weight: 700;
  }

  .blog-article a {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .blog-article a:hover {
    text-decoration-thickness: 2px;
  }

  .blog-article code {
    border-radius: var(--radius-sm);
    background: var(--color-base-300);
    padding: 0.15em 0.35em;
    color: var(--color-secondary);
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .blog-article .code-block {
    width: min(54rem, calc(100vw - 2.5rem));
    margin: 2.5rem 50%;
    overflow: hidden;
    transform: translateX(-50%);
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-md);
    background: var(--color-base-200);
  }

  .blog-article .code-block figcaption {
    border-bottom: 1px solid var(--color-base-300);
    padding: 0.625rem 1rem;
    color: var(--color-base-content-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .blog-article .code-block pre {
    margin: 0;
    overflow-x: auto;
    padding: 1.25rem;
    background: #0d1117;
    line-height: 1.7;
    tab-size: 2;
  }

  .blog-article .code-block pre:focus-visible {
    outline-offset: -3px;
  }

  .blog-article .code-block pre code {
    display: block;
    min-width: max-content;
    padding: 0;
    background: transparent;
    color: inherit;
    font-size: 0.875rem;
    white-space: pre;
  }

  .blog-article .code-block .line {
    display: inline;
  }

  .blog-article blockquote {
    margin: 2.5rem 0;
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-md);
    background: var(--color-base-200);
    padding: 1.25rem 1.5rem;
    color: var(--color-base-content-muted);
  }

  .blog-article blockquote p:last-child {
    margin-bottom: 0;
  }

  .blog-article ul,
  .blog-article ol {
    margin: 1.625rem 0;
    padding-left: 1.5rem;
  }

  .blog-article ul {
    list-style: disc;
  }

  .blog-article ol {
    list-style: decimal;
  }

  .blog-article li {
    padding-left: 0.25rem;
  }

  .blog-article li + li {
    margin-top: 0.625rem;
  }

  .blog-article li::marker {
    color: var(--color-secondary);
  }

  .blog-article p:has(> img:only-child),
  .blog-article p:has(> a:only-child > img:only-child) {
    width: min(60rem, calc(100vw - 2.5rem));
    margin: 2.75rem 50%;
    transform: translateX(-50%);
  }

  .blog-article img {
    width: auto;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-md);
  }

  .blog-article p > a:has(> img) {
    display: block;
    text-decoration: none;
  }

  .blog-article table {
    display: block;
    width: max-content;
    max-width: 100%;
    margin: 2.5rem 0;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .blog-article th,
  .blog-article td {
    border: 1px solid var(--color-base-300);
    padding: 0.625rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }

  .blog-article th {
    background: var(--color-base-200);
    color: var(--color-base-content);
    font-weight: 600;
  }

  .blog-article hr {
    margin: 3.5rem 0;
    border: 0;
    border-top: 1px solid var(--color-base-300);
  }

  @media (max-width: 639px) {
    .article-title {
      max-width: none;
      line-height: 1.04;
    }

    .blog-article {
      line-height: 1.78;
    }

    .blog-article > p:first-child {
      line-height: 1.78;
    }

    .blog-article h2 {
      margin-top: 3.25rem;
      font-size: 1.75rem;
    }

    .blog-article .code-block {
      width: calc(100% + (var(--container-padding) * 2));
      margin-right: calc(var(--container-padding) * -1);
      margin-left: calc(var(--container-padding) * -1);
      transform: none;
      border-right: 0;
      border-left: 0;
      border-radius: 0;
    }
  }

  @media print {
    .post-cover {
      padding: 0;
    }

    .blog-article .code-block {
      width: 100%;
      break-inside: avoid;
      margin-right: 0;
      margin-left: 0;
      transform: none;
      border-color: var(--color-base-300);
    }

    .blog-article .code-block pre {
      overflow: visible;
      white-space: pre-wrap;
    }

    .blog-article .code-block pre code {
      min-width: 0;
      color: black;
      white-space: pre-wrap;
    }
  }
</style>
