{
  "name": "ibrahimturan",
  "private": true,
  "type": "module",
  "version": "1.1.1",
  "scripts": {
    "dev": "astro dev --port 8080",
    "build": "astro check && astro build",
    "preview": "astro preview --port 8080",
    "lint": "eslint . --ext .astro,.vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .astro,.vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "format": "prettier --write src astro.config.ts eslint.config.js package.json README.md plans",
    "format:check": "prettier --check src astro.config.ts eslint.config.js package.json README.md plans"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.16",
    "daisyui": "^5.3.10",
    "motion-v": "^1.7.4",
    "ogl": "^1.0.11",
    "oh-vue-icons": "^1.0.0-rc3",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/vue": "^5.1.1",
    "@eslint/js": "^9.39.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.9.2",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^5.14.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-vue": "^10.5.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^6.4.3",
    "vue-eslint-parser": "^10.2.0"
  }
}
