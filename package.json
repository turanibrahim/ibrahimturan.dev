{
  "name": "ibrahimturan",
  "private": true,
  "type": "module",
  "version": "1.1.1",
  "scripts": {
    "dev": "astro dev --port 8080",
    "build": "astro check && astro build",
    "preview": "astro preview --port 8080",
    "cms:install": "npm install --prefix cms",
    "cms:dev": "npm --prefix cms run dev",
    "cms:seed": "npm --prefix cms run seed",
    "cms:export": "npm --prefix cms run export",
    "generate": "npm run cms:export && npm run build",
    "lint": "eslint . --ext .astro,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .astro,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "format": "prettier --write src cms astro.config.ts eslint.config.js package.json README.md plans",
    "format:check": "prettier --check src cms astro.config.ts eslint.config.js package.json README.md plans"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.16",
    "daisyui": "^5.3.10",
    "motion": "^13.4.0",
    "ogl": "^1.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/react": "^6.0.6",
    "@eslint/js": "^9.39.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.9.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^5.14.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^6.4.3"
  }
}
